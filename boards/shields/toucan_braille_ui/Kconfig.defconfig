    default PROSPECTOR_STATUS_SCREEN_BRAILLE

config PROSPECTOR_STATUS_SCREEN_BRAILLE
    bool "Toucan braille dashboard"
    select LV_USE_LABEL
    select LV_FONT_MONTSERRAT_14
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_28

endchoice

config TOUCAN_BRAILLE_UI_LAYER
    int "Braille keymap layer index"
    default 5

endif
