#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TAP  4

#define ZMK_POINTING_DEFAULT_SCRL_VAL 140 // Default is 10;

&msc {
    acceleration-exponent = <0>;      // Disables acceleration for flat, predictable tapping
    time-to-max-speed-ms = <0>;       // Instantly outputs full speed on tap
    delay-ms = <0>;                   // Removes tap response lag
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    // I'm disabling combos for now in favour of nested alt layer.
    //
    // combos {
    //     compatible = "zmk,combos";

    //     // Hold all four corner keys of one half to jump that half into the
    //     // bootloader. Key positions are the four corners of each 3-row block:
    //     //   left  -> top-left 0,  top-right 5,  bottom-left 24, bottom-right 29
    //     //   right -> top-left 6, top-right 11, bottom-left 30, bottom-right 35
    //     // Deliberate to hit, so they're hard to trigger by accident.
    //     combo_boot_left {
    //         timeout-ms = <100>;
    //         key-positions = <0 5 24 29>;
    //         bindings = <&bootloader>;
    //     };

    //     combo_boot_right {
    //         timeout-ms = <100>;
    //         key-positions = <6 11 30 35>;
    //         bindings = <&bootloader>;
    //     };
    // };

    behaviors {
        // "Timeless homerow mods" style hold-tap, applied as a layer-tap.
        // Tap  -> sends the key (param 2).
        // Hold -> momentarily activates the layer (param 1).
        //
        // The robustness comes from `balanced` flavor + `require-prior-idle-ms`
        // rather than from timing alone: a quick roll where the held key is
        // released first resolves as a tap, and a key pressed within
        // require-prior-idle-ms of an earlier keypress is forced to a tap so it
        // never fires mid-typing. See urob's writeup:
        //   https://github.com/urob/zmk-config#timeless-homerow-mods
        //
        // Note: the usual opposite-hand `hold-trigger-key-positions` guard is
        // intentionally omitted here because the NAV layer's keys (arrows /
        // mouse clicks) live on the same hand as `f`, so a positional guard
        // would block the very keys this layer exists to reach.
        hl: homerow_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Same timeless settings as `hl`, but a mod-tap rather than a
        // layer-tap: the hold binding is `&kp`, so holding sends a real
        // modifier (param 1) instead of switching layers, while a tap still
        // sends the key (param 2). Used for the Ctrl/Esc home-row key.
        hm: homerow_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T                                           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp MINUS       
                &hm LCTRL ESC   &kp A           &kp S           &kp D           &hl NAV F       &kp G                                           &kp H           &kp J           &kp K           &kp L           &hl NAV SEMI    &kp SQT
                &kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B                                           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RALT        
                                                                                &mo SYM         &kp BSPC        &kp LGUI        &kp SPACE       &hl SYM RET     &mo SYM
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans          &trans          &kp UP          &mkp SCRL_UP    &trans          &trans                                          &trans          &trans          &msc SCRL_UP    &trans          &trans          &trans          
                &trans          &kp LEFT        &kp DOWN        &kp RIGHT       &trans          &trans                                          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &trans          &trans          
                &trans          &trans          &trans          &mkp SCRL_DOWN  &trans          &trans                                          &trans          &trans          &msc SCRL_DOWN  &trans          &trans          &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TILDE       &kp EXCL        &kp AT          &kp LBKT        &kp RBKT        &kp PRCNT                                       &trans          &kp N7          &kp N8          &kp N9          &kp KP_MULTIPLY &trans          
                &kp GRAVE       &kp HASH        &kp DLLR        &kp LPAR        &kp RPAR        &kp CARET                                       &trans          &kp N4          &kp N5          &kp N6          &kp PLUS        &trans          
                &kp PIPE        &kp BSLH        &kp AMPS        &kp LBRC        &kp RBRC        &trans                                          &kp N0          &kp N1          &kp N2          &kp N3          &kp MINUS       &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                    &trans          &trans          &trans          &trans          &trans          &trans          
                &bootloader     &studio_unlock  &trans          &trans          &trans          &trans                                          &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &trans          &studio_unlock  &bootloader     
                &trans          &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };

        tap {
            display-name = "TAP";
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                &trans          &trans          &mkp MCLK       &mkp LCLK       &mkp RCLK       &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                &trans          &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };
    };
};

#ifdef CONFIG_ZMK_STUDIO
/ {
    keymap {
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
#endif
