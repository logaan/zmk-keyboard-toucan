#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TAP  4

#define ZMK_POINTING_DEFAULT_SCRL_VAL 140 // Default is 10;

&msc {
    acceleration-exponent = <0>;      // Disables acceleration for flat, predictable tapping
    time-to-max-speed-ms = <0>;       // Instantly outputs full speed on tap
    delay-ms = <0>;                   // Removes tap response lag
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Type numbers and bracket pairs from the BASE layer without switching
        // to SYM. Each combo is the symbol's spot on the SYM layer plus the key
        // immediately to one side, so the muscle memory follows where the symbol
        // lives on SYM. All are restricted to BASE (layers = <BASE>) so the
        // positions keep their normal behaviour on SYM/NAV/etc. timeout-ms is
        // the window in which every key of the combo must land; tune up if a
        // combo is hard to hit or down if it fires during fast typing rolls.
        //
        // Digits sit on the right hand, each shifted one key to the right of the
        // number's SYM position so the pairs land on more comfortable rolls:
        //   top row  : 7=ui  8=io  9=op
        //   home row : 4=jk  5=kl  6=l;
        //   bottom   : 1=m,  2=,.  3=./   0=m,.
        // Zero stays the three-key odd one out (m , .), nesting over the 1 and 2
        // combos; ZMK fires the longest matching combo, so m+,+. gives 0 while
        // m+, alone gives 1 and ,+. alone gives 2.
        combo_num_1 { timeout-ms = <50>; key-positions = <31 32>;    bindings = <&kp N1>; layers = <BASE>; };
        combo_num_2 { timeout-ms = <50>; key-positions = <32 33>;    bindings = <&kp N2>; layers = <BASE>; };
        combo_num_3 { timeout-ms = <50>; key-positions = <33 34>;    bindings = <&kp N3>; layers = <BASE>; };
        combo_num_4 { timeout-ms = <50>; key-positions = <19 20>;    bindings = <&kp N4>; layers = <BASE>; };
        combo_num_5 { timeout-ms = <50>; key-positions = <20 21>;    bindings = <&kp N5>; layers = <BASE>; };
        combo_num_6 { timeout-ms = <50>; key-positions = <21 22>;    bindings = <&kp N6>; layers = <BASE>; };
        combo_num_7 { timeout-ms = <50>; key-positions = <7 8>;      bindings = <&kp N7>; layers = <BASE>; };
        combo_num_8 { timeout-ms = <50>; key-positions = <8 9>;      bindings = <&kp N8>; layers = <BASE>; };
        combo_num_9 { timeout-ms = <50>; key-positions = <9 10>;     bindings = <&kp N9>; layers = <BASE>; };
        combo_num_0 { timeout-ms = <50>; key-positions = <31 32 33>; bindings = <&kp N0>; layers = <BASE>; };

        // Bracket pairs, same idea as the digits: the symbol's SYM spot plus the
        // key to its left. Left/right halves of each pair sit side by side on
        // the same BASE row as the brackets do on SYM:
        //   ( = sd  ) = df   (home row)
        //   [ = we  ] = er   (top row)
        //   { = xc  } = cv   (bottom row)
        combo_lpar { timeout-ms = <50>; key-positions = <14 15>; bindings = <&kp LPAR>; layers = <BASE>; };
        combo_rpar { timeout-ms = <50>; key-positions = <15 16>; bindings = <&kp RPAR>; layers = <BASE>; };
        combo_lbkt { timeout-ms = <50>; key-positions = <2 3>;   bindings = <&kp LBKT>; layers = <BASE>; };
        combo_rbkt { timeout-ms = <50>; key-positions = <3 4>;   bindings = <&kp RBKT>; layers = <BASE>; };
        combo_lbrc { timeout-ms = <50>; key-positions = <26 27>; bindings = <&kp LBRC>; layers = <BASE>; };
        combo_rbrc { timeout-ms = <50>; key-positions = <27 28>; bindings = <&kp RBRC>; layers = <BASE>; };

        // Disabled in favour of a nested alt layer, kept for reference:
        // hold all four corner keys of one half to jump it into the bootloader.
        //   left  -> 0 5 24 29   right -> 6 11 30 35
        // combo_boot_left  { timeout-ms = <100>; key-positions = <0 5 24 29>;  bindings = <&bootloader>; };
        // combo_boot_right { timeout-ms = <100>; key-positions = <6 11 30 35>; bindings = <&bootloader>; };
    };

    behaviors {
        // "Timeless homerow mods" style hold-tap, applied as a layer-tap.
        // Tap  -> sends the key (param 2).
        // Hold -> momentarily activates the layer (param 1).
        //
        // The robustness comes from `balanced` flavor + `require-prior-idle-ms`
        // rather than from timing alone: a quick roll where the held key is
        // released first resolves as a tap, and a key pressed within
        // require-prior-idle-ms of an earlier keypress is forced to a tap so it
        // never fires mid-typing. See urob's writeup:
        //   https://github.com/urob/zmk-config#timeless-homerow-mods
        //
        // Note: the usual opposite-hand `hold-trigger-key-positions` guard is
        // intentionally omitted here because the NAV layer's keys (arrows /
        // mouse clicks) live on the same hand as `f`, so a positional guard
        // would block the very keys this layer exists to reach.
        hl: homerow_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Same timeless settings as `hl`, but a mod-tap rather than a
        // layer-tap: the hold binding is `&kp`, so holding sends a real
        // modifier (param 1) instead of switching layers, while a tap still
        // sends the key (param 2). Used for the Ctrl/Esc home-row key.
        hm: homerow_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T                                           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp MINUS       
                &hm LCTRL ESC   &kp A           &kp S           &kp D           &hl NAV F       &kp G                                           &kp H           &kp J           &kp K           &kp L           &hl NAV SEMI    &kp SQT
                &kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B                                           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RALT        
                                                                                &mo SYM         &kp BSPC        &kp LGUI        &kp SPACE       &hl SYM RET     &mo SYM
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans          &trans          &kp UP          &mkp SCRL_UP    &trans          &trans                                          &trans          &trans          &msc SCRL_UP    &trans          &trans          &trans          
                &hm LCTRL ESC   &kp LEFT        &kp DOWN        &kp RIGHT       &trans          &trans                                          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &trans          &trans          
                &kp LSHFT       &trans          &trans          &mkp SCRL_DOWN  &trans          &trans                                          &trans          &trans          &msc SCRL_DOWN  &trans          &trans          &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TILDE       &kp EXCL        &kp AT          &kp LBKT        &kp RBKT        &kp GRAVE                                       &trans          &kp N7          &kp N8          &kp N9          &kp KP_MULTIPLY &kp PRCNT       
                &hm LCTRL ESC   &kp HASH        &kp DLLR        &kp LPAR        &kp RPAR        &kp PIPE                                        &trans          &kp N4          &kp N5          &kp N6          &kp PLUS        &kp CARET       
                &kp LSHFT       &kp BSLH        &kp AMPS        &kp LBRC        &kp RBRC        &trans                                          &kp N0          &kp N1          &kp N2          &kp N3          &kp MINUS       &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                    &trans          &trans          &trans          &trans          &trans          &trans          
                &bootloader     &studio_unlock  &trans          &trans          &trans          &trans                                          &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &trans          &studio_unlock  &bootloader     
                &trans          &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };

        tap {
            display-name = "TAP";
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                &hm LCTRL ESC   &trans          &mkp MCLK       &mkp LCLK       &mkp RCLK       &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                &kp LSHFT       &trans          &trans          &trans          &trans          &trans                                          &trans          &trans          &trans          &trans          &trans          &trans          
                                                                                &trans          &trans          &trans          &trans          &trans          &trans          
            >;
        };
    };
};

#ifdef CONFIG_ZMK_STUDIO
/ {
    keymap {
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
#endif
