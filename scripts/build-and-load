#!/usr/bin/env bash
#
# build-and-load — fetch the CI-built ZMK firmware for the current commit and
# flash it onto the Toucan halves or Prospector over the UF2 bootloader.
#
# This does NOT build locally. ZMK is built by GitHub Actions
# (.github/workflows/build.yml -> zmkfirmware build-user-config), which uploads
# an artifact containing the .uf2 files (its name may be customized). This script
# downloads the workflow artifacts and copies the .uf2 onto the bootloader drive, walking
# you through entering the bootloader from the keymap.
#
# Entering the bootloader (set up in config/toucan.keymap on the ADJ layer):
#   Hold NAV (F or ;) + SYM (far-right thumb) to reach the ADJ layer, then tap:
#       Left outer home-row key  -> puts the LEFT half into the bootloader
#       Right outer home-row key -> puts the RIGHT half into the bootloader
#   (Both halves must be powered/paired for the ADJ combo to register.)
#   Fallback: double-tap the reset button on the half you want to flash.
#
# Usage:
#   scripts/build-and-load                          # standalone left then right
#   scripts/build-and-load left                     # standalone left only
#   scripts/build-and-load right                    # right (same in both profiles)
#   scripts/build-and-load --profile prospector      # dongle, peripheral left, right
#   scripts/build-and-load --profile prospector left # peripheral left only
#   scripts/build-and-load --profile prospector dongle
#   scripts/build-and-load reset                     # wipe ONE device's settings
#   scripts/build-and-load --dry-run                 # download/list, do not flash
#   scripts/build-and-load --run 123456789           # specific workflow run id
#
# --profile defaults to standalone. Switching profiles is NOT automatic: follow
# README.md to settings-reset all devices and re-pair. Reset is never implicit.
# Mount only the device you intend to flash. The Prospector's own bootloader is
# entered by double-tapping its reset button, not the keyboard's ADJ bindings.
#
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

bold=$(tput bold 2>/dev/null || true); reset=$(tput sgr0 2>/dev/null || true)
say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s\n' "$bold" "$reset" "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

# ---- parse args before checking gh, so --help works without credentials ----
run_id=""
profile=standalone
dry_run=0
targets=()
while [ $# -gt 0 ]; do
  case "$1" in
    --run)
      [ $# -ge 2 ] || die "--run needs a run id"
      run_id="$2"; shift 2;;
    --profile)
      [ $# -ge 2 ] || die "--profile needs standalone or prospector"
      profile="$2"; shift 2;;
    --dry-run)    dry_run=1; shift;;
    left|right|dongle|reset) targets+=("$1"); shift;;
    both)         targets+=(left right); shift;;
    -h|--help)    awk 'NR == 1 {next} /^set -/ {exit} {sub(/^# ?/, ""); print}' "$0"; exit 0;;
    *)            die "unknown argument: $1 (try --help)";;
  esac
done
case "$profile" in
  standalone|prospector) ;;
  *) die "unknown profile: $profile (expected standalone or prospector)";;
esac
if [ ${#targets[@]} -eq 0 ]; then
  if [ "$profile" = prospector ]; then targets=(dongle left right); else targets=(left right); fi
fi
for t in "${targets[@]}"; do
  [ "$t" != dongle ] || [ "$profile" = prospector ] \
    || die "dongle requires --profile prospector"
done

# ---- prerequisites (detect & instruct, no auto-install) ----
missing=0
if ! command -v gh >/dev/null 2>&1; then
  say "Missing: gh (GitHub CLI).  Install it with:  brew install gh"
  missing=1
elif ! gh auth status >/dev/null 2>&1; then
  say "gh is installed but not authenticated.  Run:  gh auth login"
  missing=1
fi
[ "$missing" -eq 0 ] || die "Install/fix the prerequisites above, then re-run."

# ---- find the workflow run to download ----
sha=$(git rev-parse HEAD)
short=$(git rev-parse --short HEAD)
branch=$(git rev-parse --abbrev-ref HEAD)

if [ -z "$run_id" ]; then
  step "Looking for a CI build of the current commit ($short)…"
  run_id=$(gh run list --commit "$sha" -L 1 --json databaseId -q '.[0].databaseId' 2>/dev/null || true)
  if [ -z "$run_id" ]; then
    say "No GitHub Actions run found for commit $short."
    say "It likely hasn't been pushed yet — push it so CI builds it:"
    say "    git push origin $branch"
    say "…then re-run this script.  (Or pass --run <id> to use an existing build.)"
    die "no CI build for the current commit"
  fi
fi

# ---- wait for the run to finish, require success ----
status=$(gh run view "$run_id" --json status -q .status 2>/dev/null || die "run $run_id not found")
if [ "$status" != "completed" ]; then
  step "Build $run_id is '$status' — watching until it finishes…"
  gh run watch "$run_id" --exit-status || die "CI build failed (run $run_id)"
fi
conclusion=$(gh run view "$run_id" --json conclusion -q .conclusion)
[ "$conclusion" = "success" ] || die "CI build did not succeed (conclusion: $conclusion, run $run_id)"

# ---- download the firmware artifact ----
workdir=$(mktemp -d "${TMPDIR:-/tmp}/toucan-fw.XXXXXX")
trap 'rm -rf "$workdir"' EXIT
step "Downloading artifacts from run ${run_id}…"
# Do not hard-code the reusable workflow's archive_name. Downloading all
# artifacts puts each in its own directory (the keymap PDF is ignored below).
gh run download "$run_id" -D "$workdir" \
  || die "could not download artifacts from run $run_id"

# locate a single .uf2 matching a glob (filenames contain spaces)
find_uf2() {
  local pat="$1" matches=()
  while IFS= read -r -d '' f; do matches+=("$f"); done \
    < <(find "$workdir" -maxdepth 2 -type f -name "$pat" -print0)
  [ ${#matches[@]} -eq 1 ] || return 1
  printf '%s' "${matches[0]}"
}

# Wait for a UF2 bootloader volume (identified by INFO_UF2.TXT) to mount, copy
# the firmware onto it, then wait for it to eject (= flashing complete).
flash_file() {
  local label="$1" how="$2" uf2="$3"
  step "Flash ${label}"
  say "  → ${how}"
  say "  Waiting for the bootloader drive to mount…"

  local vol=""
  while [ -z "$vol" ]; do
    for v in /Volumes/*; do
      [ -e "$v/INFO_UF2.TXT" ] && { vol="$v"; break; }
    done
    [ -z "$vol" ] && sleep 0.4
  done

  say "  Found bootloader drive: $vol"
  say "  Copying $(basename "$uf2") …"
  cp "$uf2" "$vol"/
  sync
  say "  Waiting for the drive to eject (board reboots when done)…"
  while [ -e "$vol/INFO_UF2.TXT" ]; do sleep 0.4; done
  say "  ${bold}✓ ${label} flashed.${reset}"
}

combo="Hold NAV (F or ;) + SYM (far-right thumb) to reach ADJ, then tap"

# Resolve ALL images before touching a device. In particular, never let a
# wildcard silently select the other profile's left firmware.
firmware=()
labels=()
instructions=()
for t in "${targets[@]}"; do
  case "$t" in
    left)
      if [ "$profile" = prospector ]; then
        pattern='toucan_left_peripheral-zmk.uf2'
      else
        pattern='*toucan_left[ -]*-zmk.uf2'
      fi
      labels+=("LEFT half ($profile)")
      instructions+=("$combo the ${bold}left outer home-row key${reset} (or double-tap reset on the left half)");;
    right)
      pattern='*toucan_right[ -]*-zmk.uf2'
      labels+=("RIGHT half (shared)")
      instructions+=("$combo the ${bold}right outer home-row key${reset} (or double-tap reset on the right half)");;
    dongle)
      pattern='toucan_prospector-zmk.uf2'
      labels+=("PROSPECTOR dongle")
      instructions+=("Double-tap the reset button on the Prospector");;
    reset)
      pattern='settings_reset*-zmk.uf2'
      labels+=("SETTINGS-RESET (erases pairing and saved settings)")
      instructions+=("Double-tap reset on the ONE device you want to wipe; keep all others off");;
  esac
  f=$(find_uf2 "$pattern") || die "expected exactly one $t .uf2 for profile $profile (pattern: $pattern)"
  firmware+=("$f")
done

step "Selected firmware (profile: $profile)"
for ((i = 0; i < ${#targets[@]}; i++)); do
  say "  ${labels[$i]}: $(basename "${firmware[$i]}")"
done
if [ "$dry_run" -eq 1 ]; then
  say "Dry run: no devices flashed."
  exit 0
fi
say "Changing profiles? Follow README.md's settings-reset/re-pair procedure first."
for ((i = 0; i < ${#targets[@]}; i++)); do
  flash_file "${labels[$i]}" "${instructions[$i]}" "${firmware[$i]}"
done

step "All done."
